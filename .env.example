OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
# Chatwidget → API (publiek; ingebakken via npm run build:chat-config bij Vercel deploy)
CHAT_API_URL=https://energy-data-governance-2026-chatapi.vercel.app
# Zelfde waarde op Vercel runtime én build (Production); zichtbaar in assets/chat-config.js
CHAT_CLIENT_API_KEY=
# Exacte browser-origins (geen pad), komma-gescheiden. GitHub Pages = https://<org>.github.io
CORS_ORIGINS=https://energie-data.github.io,http://localhost:8080,http://localhost:3000
RATE_LIMIT_PER_HOUR=20
