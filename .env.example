OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
# Chatwidget aan/uit (true/false; ingebakken via npm run build:chat-config)
CHAT_ENABLED=true
# Productie-API voor GitHub Pages (ingebakken via npm run build:site). Lokaal negeert de widget dit en gebruikt :3000.
CHAT_API_URL=https://energy-data-governance-2026-chatapi.vercel.app
# Zelfde waarde op Vercel runtime én build (Production); zichtbaar in assets/chat-config.js
CHAT_CLIENT_API_KEY=
# Exacte browser-origins (geen pad), komma-gescheiden. GitHub Pages = https://<org>.github.io
CORS_ORIGINS=https://data-governance-2026.reports.energiedata.nl,https://energie-data.github.io,http://localhost:8080,http://localhost:3000
RATE_LIMIT_PER_HOUR=20
