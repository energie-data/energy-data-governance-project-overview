OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
# Chatwidget → Vercel API (publiek; wordt ingebakken via npm run build:chat-config)
CHAT_API_URL=https://energy-data-governance-2026-chatapi.vercel.app
# Comma-separated origins (GitHub Pages URL), e.g. https://org.github.io,http://localhost:8080
CORS_ORIGINS=https://your-org.github.io,http://localhost:8080,http://localhost:3000
# Optional: require X-Chat-Api-Key header from the browser widget
CHAT_CLIENT_API_KEY=
RATE_LIMIT_PER_HOUR=20
