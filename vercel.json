{
  "buildCommand": "npm run build:chat-config",
  "outputDirectory": ".",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 30,
      "includeFiles": "data/knowledge_chunks.json,data/algemene_projectcontext_openai.md"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-Chat-Api-Key" }
      ]
    }
  ]
}
